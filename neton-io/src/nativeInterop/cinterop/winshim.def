package = neton.io.win
# Only the helpers below are exported; the Winsock declarations themselves come from platform.posix / platform.windows.
headers = winsock2.h
headerFilter = neton_winshim_none.h
linkerOpts = -lws2_32 -lbcrypt -lwinmm
compilerOpts = -D_WIN32_WINNT=0x0A00

---

/* Clocks (neton.io.core.Clock). */
static long long neton_monotonic_nanos(void) {
    static LARGE_INTEGER freq;
    LARGE_INTEGER now;
    if (freq.QuadPart == 0) QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&now);
    return (long long) ((now.QuadPart / freq.QuadPart) * 1000000000LL + (now.QuadPart % freq.QuadPart) * 1000000000LL / freq.QuadPart);
}
static long long neton_realtime_millis(void) {
    FILETIME ft;
    GetSystemTimePreciseAsFileTime(&ft);
    long long t = ((long long) ft.dwHighDateTime << 32) | ft.dwLowDateTime;   /* 100 ns units since 1601 */
    return t / 10000 - 11644473600000LL;
}

/* Non-blocking recv / send / WSASend with the Winsock error taken in the same call: the count, or -(the error).
   WSAGetLastError() called afterwards from Kotlin can already read 0: returning from a foreign call, the runtime may
   make Win32 calls (TlsGetValue clears the last error on success) before the next one. */
static int neton_recv_nb(unsigned long long s, char* buf, int len) {
    int n = recv((SOCKET) s, buf, len, 0);
    return n == SOCKET_ERROR ? -WSAGetLastError() : n;
}
static int neton_send_nb(unsigned long long s, char* buf, int len) {
    int n = send((SOCKET) s, buf, len, 0);
    return n == SOCKET_ERROR ? -WSAGetLastError() : n;
}
static long long neton_sendv_nb(unsigned long long s, void* bufs, unsigned int n) {
    DWORD sent = 0;
    if (WSASend((SOCKET) s, (WSABUF*) bufs, n, &sent, 0, NULL, NULL) == 0) return (long long) sent;
    return -(long long) WSAGetLastError();
}
/* accept / connect / bind / listen likewise: the error is taken inside the call (0 = success). */
static unsigned long long neton_accept_nb(unsigned long long ls, int* err) {
    SOCKET s = accept((SOCKET) ls, NULL, NULL);
    *err = s == INVALID_SOCKET ? WSAGetLastError() : 0;
    return (unsigned long long) s;
}
static int neton_connect_err(unsigned long long s, void* addr, int len) {
    return connect((SOCKET) s, (const struct sockaddr*) addr, len) == 0 ? 0 : WSAGetLastError();
}
static int neton_bind_err(unsigned long long s, void* addr, int len) {
    return bind((SOCKET) s, (const struct sockaddr*) addr, len) == 0 ? 0 : WSAGetLastError();
}
static int neton_listen_err(unsigned long long s, int backlog) {
    return listen((SOCKET) s, backlog) == 0 ? 0 : WSAGetLastError();
}

/* Integer socket options: setsockopt takes `const char*` on Windows, which cinterop maps to a String. */
static int neton_setsockopt_int(unsigned long long s, int level, int opt, int value) {
    return setsockopt((SOCKET) s, level, opt, (const char*) &value, (int) sizeof value);
}
static int neton_getsockopt_int(unsigned long long s, int level, int opt, int* value) {
    int len = (int) sizeof *value;
    return getsockopt((SOCKET) s, level, opt, (char*) value, &len);
}
/* SO_LINGER: Windows' struct linger has u_short fields. */
static int neton_setsockopt_linger(unsigned long long s, int onoff, int seconds) {
    struct linger l; l.l_onoff = (u_short) onoff; l.l_linger = (u_short) seconds;
    return setsockopt((SOCKET) s, SOL_SOCKET, SO_LINGER, (const char*) &l, (int) sizeof l);
}
/* Winsock must be started once per process before any socket call. */
static int neton_wsa_startup(void) {
    WSADATA data;
    return WSAStartup(MAKEWORD(2, 2), &data);
}

/* ---- IOCP (SPEC §22, §23.1). Only primitive types cross into Kotlin; Win32 structs stay here. ---- */
#include <mswsock.h>
#include <stdlib.h>
#include <string.h>

/* One in-flight operation. OVERLAPPED comes first, so a completion's OVERLAPPED* is the op. */
typedef struct neton_op {
    OVERLAPPED ov;
    unsigned int slot, gen;          /* the reactor's slot for this op */
    SOCKET sock;                     /* socket the op runs on (result lookup, cancel) */
    SOCKET accepted;                 /* AcceptEx: the socket prepared for the peer */
    WSABUF one;
    DWORD flags;
    DWORD bytes;                     /* bytes transferred when the op completed at once */
    char addrbuf[2 * (sizeof(SOCKADDR_STORAGE) + 16)];
} neton_op;

static void* neton_op_new(void) {
    neton_op* op = (neton_op*) calloc(1, sizeof(neton_op));
    if (op) op->accepted = INVALID_SOCKET;
    return op;
}
static void neton_op_free(void* p) { free(p); }
static void neton_op_set_id(void* p, unsigned int slot, unsigned int gen) { neton_op* op = (neton_op*) p; op->slot = slot; op->gen = gen; }
static unsigned int neton_op_slot(void* p) { return ((neton_op*) p)->slot; }
static unsigned int neton_op_gen(void* p) { return ((neton_op*) p)->gen; }
static unsigned int neton_op_bytes(void* p) { return (unsigned int) ((neton_op*) p)->bytes; }

static void* neton_iocp_create(void) { return (void*) CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, 1); }
static void neton_iocp_close(void* port) { CloseHandle((HANDLE) port); }

/* Associate socket s with the port. Returns 0 or a Win32 error. *skip = 1 when completions for ops
   that finish at once are skipped (FILE_SKIP_COMPLETION_PORT_ON_SUCCESS): the caller takes the result
   directly and no packet follows. */
static int neton_iocp_associate(void* port, unsigned long long s, int wantSkip, int* skip) {
    *skip = 0;
    if (CreateIoCompletionPort((HANDLE) (SOCKET) s, (HANDLE) port, 0, 0) == NULL) return (int) GetLastError();
    if (wantSkip && SetFileCompletionNotificationModes((HANDLE) (SOCKET) s,
            FILE_SKIP_COMPLETION_PORT_ON_SUCCESS | FILE_SKIP_SET_EVENT_ON_HANDLE)) *skip = 1;
    return 0;
}

/* Cross-thread wakeup: a packet with no OVERLAPPED. */
static int neton_iocp_post(void* port) { return PostQueuedCompletionStatus((HANDLE) port, 0, 1, NULL) ? 0 : (int) GetLastError(); }

/* Wait up to timeoutMs (0xFFFFFFFF = forever) for at most max (<= 256) completions. For each:
   ops[i] = the op (NULL for a wakeup), bytes[i], errs[i] = 0 or the Winsock error.
   Returns the count (0 on timeout) or -(Win32 error). */
static int neton_iocp_wait(void* port, void** ops, unsigned int* bytes, int* errs, int max, unsigned int timeoutMs) {
    OVERLAPPED_ENTRY entries[256];
    ULONG n = 0, i;
    if (max > 256) max = 256;
    if (!GetQueuedCompletionStatusEx((HANDLE) port, entries, (ULONG) max, &n, (DWORD) timeoutMs, FALSE)) {
        DWORD e = GetLastError();
        return e == WAIT_TIMEOUT ? 0 : -(int) e;
    }
    for (i = 0; i < n; i++) {
        OVERLAPPED* ov = entries[i].lpOverlapped;
        if (ov == NULL) { ops[i] = NULL; bytes[i] = 0; errs[i] = 0; continue; }
        neton_op* op = (neton_op*) ov;
        DWORD b = 0, fl = 0;
        ops[i] = op;
        if (WSAGetOverlappedResult(op->sock, ov, &b, FALSE, &fl)) { bytes[i] = b; errs[i] = 0; }
        else { bytes[i] = entries[i].dwNumberOfBytesTransferred; errs[i] = WSAGetLastError(); if (errs[i] == 0) errs[i] = WSAECONNABORTED; }
    }
    return (int) n;
}

/* Start results: 0 = completed now (bytes in the op), 1 = pending (a completion will follow),
   anything else = the Winsock error (always > 1). */
static int neton_start_result(int ok, int skip) {
    int e;
    if (ok) return skip ? 0 : 1;
    e = WSAGetLastError();
    return e == WSA_IO_PENDING ? 1 : e;
}

static int neton_recv(unsigned long long s, void* p, char* buf, unsigned int len, int skip) {
    neton_op* op = (neton_op*) p;
    memset(&op->ov, 0, sizeof op->ov);
    op->sock = (SOCKET) s; op->one.buf = buf; op->one.len = len; op->flags = 0; op->bytes = 0;
    return neton_start_result(WSARecv((SOCKET) s, &op->one, 1, &op->bytes, &op->flags, &op->ov, NULL) == 0, skip);
}

static int neton_send(unsigned long long s, void* p, char* buf, unsigned int len, int skip) {
    neton_op* op = (neton_op*) p;
    memset(&op->ov, 0, sizeof op->ov);
    op->sock = (SOCKET) s; op->one.buf = buf; op->one.len = len; op->bytes = 0;
    return neton_start_result(WSASend((SOCKET) s, &op->one, 1, &op->bytes, 0, &op->ov, NULL) == 0, skip);
}

static void* neton_wsabufs_new(unsigned int n) { return calloc(n ? n : 1, sizeof(WSABUF)); }
static void neton_wsabuf_set(void* a, unsigned int i, char* buf, unsigned int len) { ((WSABUF*) a)[i].buf = buf; ((WSABUF*) a)[i].len = len; }
static void neton_free(void* p) { free(p); }

static int neton_sendv(unsigned long long s, void* p, void* bufs, unsigned int n, int skip) {
    neton_op* op = (neton_op*) p;
    memset(&op->ov, 0, sizeof op->ov);
    op->sock = (SOCKET) s; op->bytes = 0;
    return neton_start_result(WSASend((SOCKET) s, (WSABUF*) bufs, n, &op->bytes, 0, &op->ov, NULL) == 0, skip);
}

static LPFN_ACCEPTEX neton_acceptex = NULL;

/* AcceptEx on listen socket l: prepares a socket of the listener's family and starts the accept. */
static int neton_accept(unsigned long long l, void* p, int skip) {
    neton_op* op = (neton_op*) p;
    WSAPROTOCOL_INFOW info;
    int il = (int) sizeof info, e;
    const DWORD al = (DWORD) (sizeof(SOCKADDR_STORAGE) + 16);
    SOCKET a;
    if (neton_acceptex == NULL) {
        GUID g = WSAID_ACCEPTEX;
        LPFN_ACCEPTEX fn = NULL;
        DWORD out = 0;
        if (WSAIoctl((SOCKET) l, SIO_GET_EXTENSION_FUNCTION_POINTER, &g, sizeof g, &fn, sizeof fn, &out, NULL, NULL) != 0) return WSAGetLastError();
        neton_acceptex = fn;
    }
    if (getsockopt((SOCKET) l, SOL_SOCKET, SO_PROTOCOL_INFOW, (char*) &info, &il) != 0) return WSAGetLastError();
    a = WSASocketW(info.iAddressFamily, info.iSocketType, info.iProtocol, NULL, 0, WSA_FLAG_OVERLAPPED);
    if (a == INVALID_SOCKET) return WSAGetLastError();
    memset(&op->ov, 0, sizeof op->ov);
    op->sock = (SOCKET) l; op->accepted = a; op->bytes = 0;
    if (neton_acceptex((SOCKET) l, a, op->addrbuf, 0, al, al, &op->bytes, &op->ov)) return skip ? 0 : 1;
    e = WSAGetLastError();
    if (e == ERROR_IO_PENDING) return 1;
    closesocket(a); op->accepted = INVALID_SOCKET;
    return e;
}

/* After an accept completed: the accepted socket, or 0 if it could not be set up (it is closed). */
static unsigned long long neton_accept_finish(unsigned long long l, void* p) {
    neton_op* op = (neton_op*) p;
    SOCKET a = op->accepted, ls = (SOCKET) l;
    op->accepted = INVALID_SOCKET;
    if (a == INVALID_SOCKET) return 0;
    if (setsockopt(a, SOL_SOCKET, SO_UPDATE_ACCEPT_CONTEXT, (char*) &ls, (int) sizeof ls) != 0) { closesocket(a); return 0; }
    return (unsigned long long) a;
}

/* An accept that failed or whose awaiter is gone: close the prepared socket. */
static void neton_accept_discard(void* p) {
    neton_op* op = (neton_op*) p;
    if (op->accepted != INVALID_SOCKET) { closesocket(op->accepted); op->accepted = INVALID_SOCKET; }
}

/* Cancel one op (p) or every op on s (p == NULL). Its completion still arrives (aborted). */
static void neton_cancel(unsigned long long s, void* p) { CancelIoEx((HANDLE) (SOCKET) s, p ? &((neton_op*) p)->ov : NULL); }

/* Non-blocking connect finished (successfully or not)? 1 yes, 0 not yet. */
static int neton_connect_done(unsigned long long s) {
    WSAPOLLFD f;
    int err = 0, len = (int) sizeof err, rc;
    f.fd = (SOCKET) s; f.events = POLLOUT; f.revents = 0;
    rc = WSAPoll(&f, 1, 0);
    if (rc != 0) return 1;                      /* ready, failed, or WSAPoll error: the caller reads SO_ERROR */
    if (getsockopt((SOCKET) s, SOL_SOCKET, SO_ERROR, (char*) &err, &len) == 0 && err != 0) return 1;
    return 0;
}

/*
 * SPEC §27.1: console control events stand in for signals. The handler records the kind (1 Int,
 * 2 Term, 3 Quit) and sets an event; a Kotlin thread waits on it.
 */
static HANDLE neton_ctrl_event = NULL;
static volatile LONG neton_ctrl_last = 0;

static BOOL WINAPI neton_ctrl_handler(DWORD type) {
    LONG kind = type == CTRL_C_EVENT ? 1 : (type == CTRL_BREAK_EVENT ? 3 : 2);
    InterlockedExchange(&neton_ctrl_last, kind);
    SetEvent(neton_ctrl_event);
    return TRUE;
}

static int neton_ctrl_install(void) {
    if (neton_ctrl_event == NULL) neton_ctrl_event = CreateEventW(NULL, FALSE, FALSE, NULL);
    if (neton_ctrl_event == NULL) return -1;
    return SetConsoleCtrlHandler(neton_ctrl_handler, TRUE) ? 0 : -1;
}

/* SPEC §27.7: remove the handler when nobody waits. */
static int neton_ctrl_uninstall(void) {
    return SetConsoleCtrlHandler(neton_ctrl_handler, FALSE) ? 0 : -1;
}

static int neton_ctrl_wait(void) {
    WaitForSingleObject(neton_ctrl_event, INFINITE);
    return (int) InterlockedExchange(&neton_ctrl_last, 0);
}

/* SPEC §27.2: pin the calling thread to the n-th CPU (modulo) of the process affinity mask. */
static int neton_pin_thread_nth(int n) {
    DWORD_PTR proc = 0, sys = 0;
    int count = 0, want, seen = 0, cpu;
    if (!GetProcessAffinityMask(GetCurrentProcess(), &proc, &sys) || proc == 0) return -1;
    for (cpu = 0; cpu < (int) (8 * sizeof(DWORD_PTR)); cpu++) if (proc & ((DWORD_PTR) 1 << cpu)) count++;
    want = n % count;
    for (cpu = 0; cpu < (int) (8 * sizeof(DWORD_PTR)); cpu++) {
        if (!(proc & ((DWORD_PTR) 1 << cpu))) continue;
        if (seen++ == want) return SetThreadAffinityMask(GetCurrentThread(), (DWORD_PTR) 1 << cpu) != 0 ? cpu : -1;
    }
    return -1;
}

/* SPEC §28.15: the OS CSPRNG. 0 on success. */
#include <bcrypt.h>
static int neton_secure_random(unsigned char *buf, unsigned long len) {
    return BCryptGenRandom(NULL, buf, (ULONG) len, BCRYPT_USE_SYSTEM_PREFERRED_RNG) == 0 ? 0 : -1;
}

/* ---------------------------------------------------------------------------------------------------------
 * SPEC §29.7: UDP on Windows, after quinn-udp 0.11 windows.rs: WSARecvMsg / WSASendMsg with PKTINFO and ECN control
 * messages, USO (UDP_SEND_MSG_SIZE) when the stack accepts it. The boundary is posixshim's: family 4 or 6, ip[16]
 * (IPv4 in the first 4 bytes), port, scope id. Results are a count or -(Winsock error), taken inside the call.
 * mingw-w64's headers lack the ECN and USO / URO constants: the values are the Windows SDK's (ws2ipdef.h).
 */
#include <ws2tcpip.h>
#ifndef IP_ECN
#define IP_ECN 50
#endif
#ifndef IP_RECVECN
#define IP_RECVECN 50
#endif
#ifndef IPV6_ECN
#define IPV6_ECN 50
#endif
#ifndef IPV6_RECVECN
#define IPV6_RECVECN 50
#endif
#ifndef UDP_SEND_MSG_SIZE
#define UDP_SEND_MSG_SIZE 2
#endif
#ifndef UDP_COALESCED_INFO
#define UDP_COALESCED_INFO 3
#endif
#define NETON_WUDP_CMSG 128

static LPFN_WSARECVMSG neton_wsarecvmsg = NULL;   /* the same for every socket; written once, races are benign */
static int neton_wudp_gso = 0;                     /* 0 = not probed yet */

static int neton_wudp_opt(SOCKET s, int level, int name, DWORD value) {
    return setsockopt(s, level, name, (const char*) &value, (int) sizeof value) == 0;
}

static int neton_wudp_fill(void* out, int sock_v6, int family, const unsigned char* ip, int port, unsigned int scope) {
    SOCKADDR_STORAGE* ss = (SOCKADDR_STORAGE*) out;
    memset(ss, 0, sizeof *ss);
    if (family == 4 && !sock_v6) {
        struct sockaddr_in* a = (struct sockaddr_in*) ss;
        a->sin_family = AF_INET; a->sin_port = htons((u_short) port);
        memcpy(&a->sin_addr, ip, 4);
        return (int) sizeof *a;
    } else {
        /* An IPv4 destination on an IPv6 (dual-stack) socket goes out as a v4-mapped address. */
        struct sockaddr_in6* a = (struct sockaddr_in6*) ss;
        a->sin6_family = AF_INET6; a->sin6_port = htons((u_short) port);
        if (family == 4) {
            a->sin6_addr.s6_addr[10] = 0xff; a->sin6_addr.s6_addr[11] = 0xff;
            memcpy(&a->sin6_addr.s6_addr[12], ip, 4);
        } else {
            memcpy(&a->sin6_addr, ip, 16);
            a->sin6_scope_id = scope;
        }
        return (int) sizeof *a;
    }
}

static void neton_wudp_read(const void* in, int* family, unsigned char* ip, int* port, unsigned int* scope) {
    const SOCKADDR_STORAGE* ss = (const SOCKADDR_STORAGE*) in;
    if (ss->ss_family == AF_INET) {
        const struct sockaddr_in* a = (const struct sockaddr_in*) ss;
        *family = 4; memset(ip, 0, 16); memcpy(ip, &a->sin_addr, 4);
        *port = ntohs(a->sin_port); *scope = 0;
    } else {
        const struct sockaddr_in6* a = (const struct sockaddr_in6*) ss;
        *family = 6; memcpy(ip, &a->sin6_addr, 16);
        *port = ntohs(a->sin6_port); *scope = a->sin6_scope_id;
    }
}

/* A non-blocking UDP socket bound to the address; an IPv6 socket is dual-stack unless v6only. The socket, or -error. */
static int neton_wudp_bind(int family, const unsigned char* ip, int port, unsigned int scope, int v6only) {
    SOCKADDR_STORAGE ss;
    u_long nb = 1;
    int len, e;
    SOCKET s = socket(family == 6 ? AF_INET6 : AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (s == INVALID_SOCKET) return -WSAGetLastError();
    if (s > 0x7fffffff) { closesocket(s); return -WSAEMFILE; }   /* the reactor keeps sockets as Int */
    if (ioctlsocket(s, FIONBIO, &nb) != 0) { e = WSAGetLastError(); closesocket(s); return -e; }
    if (family == 6) (void) neton_wudp_opt(s, IPPROTO_IPV6, IPV6_V6ONLY, v6only ? 1 : 0);
    len = neton_wudp_fill(&ss, family == 6, family, ip, port, scope);
    if (bind(s, (struct sockaddr*) &ss, len) != 0) { e = WSAGetLastError(); closesocket(s); return -e; }
    return (int) s;
}

/* quinn-udp MAX_GSO_SEGMENTS: UDP_SEND_MSG_SIZE accepted on a separate socket (as a socket option it would
   segment every send) -> 512 ("empirically found on Windows 11 x64"), else 1. */
static int neton_wudp_probe_gso(void) {
    struct sockaddr_in a;
    int ok;
    SOCKET t = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (t == INVALID_SOCKET) return 1;
    memset(&a, 0, sizeof a); a.sin_family = AF_INET; a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
    ok = bind(t, (struct sockaddr*) &a, sizeof a) == 0 && neton_wudp_opt(t, IPPROTO_UDP, UDP_SEND_MSG_SIZE, 1500);
    closesocket(t);
    return ok ? 512 : 1;
}

/* A dual-stack IPv6 socket carries IPv4 only when bound to :: or a v4-mapped address; Windows rejects the IPv4 options
   (WSAEINVAL) on one bound to another IPv6 address such as ::1. The reference never meets this: Rust's std leaves
   IPV6_V6ONLY on (the Windows default), and quinn-udp reads it back. */
static int neton_wudp_carries_ipv4(SOCKET s) {
    struct sockaddr_in6 a;
    int len = (int) sizeof a, i;
    if (getsockname(s, (struct sockaddr*) &a, &len) != 0 || a.sin6_family != AF_INET6) return 1;
    for (i = 0; i < 10; i++) if (a.sin6_addr.s6_addr[i]) return 0;
    if (a.sin6_addr.s6_addr[10] == 0xff && a.sin6_addr.s6_addr[11] == 0xff) return 1;   /* v4-mapped */
    if (a.sin6_addr.s6_addr[10] || a.sin6_addr.s6_addr[11]) return 0;
    for (i = 12; i < 16; i++) if (a.sin6_addr.s6_addr[i]) return 0;
    return 1;                                                                          /* :: */
}

/* Socket options as quinn-udp's UdpSocketState::new; every one is required, as there. Writes the GSO and GRO
   segment counts; returns may_fragment (always 0: don't-fragment is set) or -error. */
static int neton_wudp_setup(unsigned long long sock, int v6, int v6only, int* gso, int* gro) {
    SOCKET s = (SOCKET) sock;
    int is_ipv4 = !v6 || (!v6only && neton_wudp_carries_ipv4(s));
    *gso = 1; *gro = 64;   /* quinn-udp gro_segments: 64, a buffer factor even with URO off (its default) */
    if (neton_wsarecvmsg == NULL) {
        GUID guid = WSAID_WSARECVMSG;
        LPFN_WSARECVMSG fn = NULL;
        DWORD len = 0;
        if (WSAIoctl(s, SIO_GET_EXTENSION_FUNCTION_POINTER, &guid, sizeof guid, &fn, sizeof fn, &len, NULL, NULL) != 0)
            return -WSAGetLastError();
        if (fn == NULL || len != sizeof fn) return -WSAEOPNOTSUPP;
        neton_wsarecvmsg = fn;
    }
    if (is_ipv4) {
        if (!neton_wudp_opt(s, IPPROTO_IP, IP_DONTFRAGMENT, 1)) return -WSAGetLastError();
        if (!neton_wudp_opt(s, IPPROTO_IP, IP_PKTINFO, 1)) return -WSAGetLastError();
        if (!neton_wudp_opt(s, IPPROTO_IP, IP_RECVECN, 1)) return -WSAGetLastError();
    }
    if (v6) {
        if (!neton_wudp_opt(s, IPPROTO_IPV6, IPV6_DONTFRAG, 1)) return -WSAGetLastError();
        if (!neton_wudp_opt(s, IPPROTO_IPV6, IPV6_PKTINFO, 1)) return -WSAGetLastError();
        if (!neton_wudp_opt(s, IPPROTO_IPV6, IPV6_RECVECN, 1)) return -WSAGetLastError();
    }
    if (neton_wudp_gso == 0) neton_wudp_gso = neton_wudp_probe_gso();
    *gso = neton_wudp_gso;
    return 0;
}

static int neton_wudp_local(unsigned long long s, int* family, unsigned char* ip, int* port, unsigned int* scope) {
    SOCKADDR_STORAGE ss;
    int len = (int) sizeof ss;
    if (getsockname((SOCKET) s, (struct sockaddr*) &ss, &len) != 0) return -WSAGetLastError();
    neton_wudp_read(&ss, family, ip, port, scope);
    return 0;
}

/* Get (value < 0) or set a socket buffer size; which: 0 send, 1 receive. The size, or -error. */
static int neton_wudp_buffer(unsigned long long s, int which, int value) {
    int name = which ? SO_RCVBUF : SO_SNDBUF, out = 0, len = (int) sizeof out;
    if (value >= 0 && setsockopt((SOCKET) s, SOL_SOCKET, name, (const char*) &value, (int) sizeof value) != 0) return -WSAGetLastError();
    if (getsockopt((SOCKET) s, SOL_SOCKET, name, (char*) &out, &len) != 0) return -WSAGetLastError();
    return out;
}

/* Receive one datagram (quinn-udp recv): length, URO stride, source, ECN bits, destination. 1, or -error
   (WSAEWOULDBLOCK when nothing is queued). */
static int neton_wudp_recv(unsigned long long s, unsigned char* buf, int slot_len,
                           int* lens, int* strides, int* families, unsigned char* ips, int* ports, unsigned int* scopes,
                           int* ecns, int* dst_families, unsigned char* dst_ips) {
    SOCKADDR_STORAGE src;
    WSABUF data;
    WSAMSG msg;
    DWORD len = 0;
    union { WSACMSGHDR align; char b[NETON_WUDP_CMSG]; } ctrl;
    WSACMSGHDR* c;
    if (neton_wsarecvmsg == NULL) return -WSAEOPNOTSUPP;
    memset(&src, 0, sizeof src); memset(&msg, 0, sizeof msg); memset(&ctrl, 0, sizeof ctrl);
    data.buf = (char*) buf; data.len = (ULONG) slot_len;
    msg.name = (LPSOCKADDR) &src; msg.namelen = (int) sizeof src;
    msg.lpBuffers = &data; msg.dwBufferCount = 1;
    msg.Control.buf = ctrl.b; msg.Control.len = (ULONG) sizeof ctrl.b;
    if (neton_wsarecvmsg((SOCKET) s, &msg, &len, NULL, NULL) != 0) return -WSAGetLastError();
    lens[0] = (int) len; strides[0] = (int) len; ecns[0] = 0; dst_families[0] = 0;
    neton_wudp_read(&src, &families[0], ips, &ports[0], &scopes[0]);
    for (c = WSA_CMSG_FIRSTHDR(&msg); c != NULL; c = WSA_CMSG_NXTHDR(&msg, c)) {
        if (c->cmsg_level == IPPROTO_IP && c->cmsg_type == IP_PKTINFO) {
            IN_PKTINFO pi; memcpy(&pi, WSA_CMSG_DATA(c), sizeof pi);
            dst_families[0] = 4; memset(dst_ips, 0, 16); memcpy(dst_ips, &pi.ipi_addr, 4);
        } else if (c->cmsg_level == IPPROTO_IPV6 && c->cmsg_type == IPV6_PKTINFO) {
            IN6_PKTINFO pi; memcpy(&pi, WSA_CMSG_DATA(c), sizeof pi);
            dst_families[0] = 6; memcpy(dst_ips, &pi.ipi6_addr, 16);
        } else if ((c->cmsg_level == IPPROTO_IP && c->cmsg_type == IP_ECN) || (c->cmsg_level == IPPROTO_IPV6 && c->cmsg_type == IPV6_ECN)) {
            int v; memcpy(&v, WSA_CMSG_DATA(c), sizeof v); ecns[0] = v & 3;     /* a C int (winsock-ecn) */
        } else if (c->cmsg_level == IPPROTO_UDP && c->cmsg_type == UDP_COALESCED_INFO) {
            DWORD v; memcpy(&v, WSA_CMSG_DATA(c), sizeof v); strides[0] = (int) v;
        }
    }
    return 1;
}

/* One control message into the send buffer at *c; advances *c and *used. */
static void neton_wudp_push(WSAMSG* msg, WSACMSGHDR** c, ULONG* used, int level, int type, const void* data, int size) {
    (*c)->cmsg_level = level; (*c)->cmsg_type = type; (*c)->cmsg_len = WSA_CMSG_LEN(size);
    memcpy(WSA_CMSG_DATA(*c), data, (size_t) size);
    *used += (ULONG) WSA_CMSG_SPACE(size);
    *c = WSA_CMSG_NXTHDR(msg, *c);
}

/*
 * Send one transmit (quinn-udp windows.rs send): source IP as IP_PKTINFO / IPV6_PKTINFO, ECN as IP_ECN (IPv4 or
 * v4-mapped destination) or IPV6_ECN, UDP_SEND_MSG_SIZE when segment_size < len (USO). einval_mode: ECN is left out
 * once a send failed with WSAEINVAL (a stack without ECN on send; the reference fails every send there). Bytes sent,
 * or -error.
 */
static int neton_wudp_send(unsigned long long s, int sock_v6, const unsigned char* data, int len,
                           int family, const unsigned char* ip, int port, unsigned int scope,
                           int ecn, int segment_size, int src_family, const unsigned char* src_ip, int einval_mode) {
    SOCKADDR_STORAGE ss;
    WSABUF buf;
    WSAMSG msg;
    DWORD sent = 0;
    union { WSACMSGHDR align; char b[NETON_WUDP_CMSG]; } ctrl;
    WSACMSGHDR* c;
    ULONG used = 0;
    int is_ipv4 = family == 4 || (family == 6 && ip[10] == 0xff && ip[11] == 0xff
        && !ip[0] && !ip[1] && !ip[2] && !ip[3] && !ip[4] && !ip[5] && !ip[6] && !ip[7] && !ip[8] && !ip[9]);
    memset(&msg, 0, sizeof msg); memset(&ctrl, 0, sizeof ctrl);
    buf.buf = (char*) data; buf.len = (ULONG) len;
    msg.name = (LPSOCKADDR) &ss; msg.namelen = neton_wudp_fill(&ss, sock_v6, family, ip, port, scope);
    msg.lpBuffers = &buf; msg.dwBufferCount = 1;
    msg.Control.buf = ctrl.b; msg.Control.len = (ULONG) sizeof ctrl.b;
    c = WSA_CMSG_FIRSTHDR(&msg);
    if (src_family == 4) {
        IN_PKTINFO pi; memset(&pi, 0, sizeof pi); memcpy(&pi.ipi_addr, src_ip, 4);
        neton_wudp_push(&msg, &c, &used, IPPROTO_IP, IP_PKTINFO, &pi, (int) sizeof pi);
    } else if (src_family == 6) {
        IN6_PKTINFO pi; memset(&pi, 0, sizeof pi); memcpy(&pi.ipi6_addr, src_ip, 16);
        neton_wudp_push(&msg, &c, &used, IPPROTO_IPV6, IPV6_PKTINFO, &pi, (int) sizeof pi);
    }
    if (!einval_mode) {
        int v = ecn;
        if (is_ipv4) neton_wudp_push(&msg, &c, &used, IPPROTO_IP, IP_ECN, &v, (int) sizeof v);
        else neton_wudp_push(&msg, &c, &used, IPPROTO_IPV6, IPV6_ECN, &v, (int) sizeof v);
    }
    if (segment_size > 0 && segment_size < len) {
        DWORD v = (DWORD) segment_size;
        neton_wudp_push(&msg, &c, &used, IPPROTO_UDP, UDP_SEND_MSG_SIZE, &v, (int) sizeof v);
    }
    msg.Control.len = used;
    if (used == 0) msg.Control.buf = NULL;
    if (WSASendMsg((SOCKET) s, &msg, 0, &sent, NULL, NULL) != 0) return -WSAGetLastError();
    return (int) sent;
}

/*
 * IOCP readiness for UDP: a zero-byte overlapped WSARecv with MSG_PEEK completes when a datagram is queued and takes
 * nothing (libuv's zero read for UDP). Failing at once with WSAEMSGSIZE (the datagram does not fit zero bytes) or a
 * reset reported by ICMP means a receive will not block: 0, as a completion now. Otherwise as neton_start_result.
 */
static char neton_zero_byte;
static int neton_udp_peek(unsigned long long s, void* p, int skip) {
    neton_op* op = (neton_op*) p;
    int e;
    memset(&op->ov, 0, sizeof op->ov);
    op->sock = (SOCKET) s; op->one.buf = &neton_zero_byte; op->one.len = 0; op->flags = MSG_PEEK; op->bytes = 0;
    if (WSARecv((SOCKET) s, &op->one, 1, &op->bytes, &op->flags, &op->ov, NULL) == 0) return skip ? 0 : 1;
    e = WSAGetLastError();
    if (e == WSA_IO_PENDING) return 1;
    if (e == WSAEMSGSIZE || e == WSAECONNRESET || e == WSAENETRESET) return 0;
    return e;
}

/* A UDP socket's send buffer has room (WSAPoll, no wait): 1 yes, 0 no. */
static int neton_poll_writable(unsigned long long s) {
    WSAPOLLFD f;
    f.fd = (SOCKET) s; f.events = POLLWRNORM; f.revents = 0;
    return WSAPoll(&f, 1, 0) != 0 ? 1 : 0;
}

/*
 * SPEC §29.8: the system timer period. Windows ticks every 15.6 ms by default, so a 1 ms wait in
 * GetQueuedCompletionStatusEx or WSAPoll woke 13-15 ms late (CI) and QUIC's pacing and loss timers ran at a fifth of
 * their rate. Each reactor raises the resolution to 1 ms while it runs (Windows counts the calls; since Windows 10 2004
 * the setting is per process). 1 when the period was set (then end it once), 0 otherwise.
 */
#include <mmsystem.h>
static int neton_timer_period_begin(void) { return timeBeginPeriod(1) == TIMERR_NOERROR ? 1 : 0; }
static void neton_timer_period_end(void) { timeEndPeriod(1); }

